# ==============================================================================
# TrackIt Environment Variables Configuration
# Copy this file to .env.local and fill in your values.
# See SETUP.md for step-by-step account creation and key generation instructions.
# ==============================================================================

# Runtime Environment
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB Atlas Free Tier (M0 - 512 MB storage, 500 max connections)
# Connection string with retryWrites and majority write concern
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/watchtrack?retryWrites=true&w=majority
MONGODB_DB_NAME=watchtrack

# Security Secrets
# MASTER_ENCRYPTION_KEY: 32 bytes as 64-char hex string for AES-256-GCM encryption of user API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SESSION_SECRET: Minimum 32-character secret for signing sessions and tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_session_secret_at_least_32_chars_long

# CRON_SECRET: Bearer token expected in the Authorization header for the daily cron endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=replace_with_a_secure_cron_secret_at_least_16_chars_long

# Brevo (formerly Sendinblue) - Free Plan (300 emails/day)
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=TrackIt

